<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.App" parent="Theme.AppCompat.DayNight.NoActionBar">

        <item name="android:fontFamily">sans</item>

        <!-- Mesma cor da tela inicial: é o que aparece enquanto o app abre. -->
        <item name="android:windowBackground">@color/fundo_tela</item>

        <item name="android:colorAccent">#E10600</item>

        <!-- As barras do sistema acompanham o fundo preto do app. -->
        <item name="android:navigationBarColor">#000000</item>

        <item name="android:navigationBarDividerColor">#000000</item>

        <item name="android:statusBarColor">#000000</item>

        <item name="android:windowLightStatusBar">false</item>

        <item name="android:windowLightNavigationBar">false</item>

        <!-- A janela de abertura do sistema fica ativa: sem ela, a tela fica em branco até o app terminar de montar a primeira tela. -->
        <item name="android:windowDisablePreview">false</item>

    </style>

    <!-- Painel de filtros: sobe do pé da tela e desce ao fechar -->
    <style name="AnimacaoPainelFiltros">
        <item name="android:windowEnterAnimation">@anim/painel_sobe</item>
        <item name="android:windowExitAnimation">@anim/painel_desce</item>
    </style>

</resources>

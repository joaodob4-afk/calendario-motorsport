<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingEnd="12dp"
    android:background="@drawable/card_destaque">

    <!-- Faixa na cor da categoria, encostada na lateral esquerda (cor definida no Kotlin) -->
    <View
        android:id="@+id/itemAcento"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/acento" />

    <ImageView
        android:id="@+id/itemBandeira"
        android:layout_width="42dp"
        android:layout_height="28dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:scaleType="centerCrop"
        android:contentDescription="Bandeira do país" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/itemPais"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Brasil"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="13sp"
            app:autoSizeMaxTextSize="18sp"
            app:autoSizeStepGranularity="0.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_pin"
                android:tint="@color/texto_suave"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/itemCircuito"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Interlagos"
                android:textColor="@color/texto_suave"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </LinearLayout>

    <!-- Categoria (a fonte se ajusta ao tamanho do nome) -->
    <TextView
        android:id="@+id/itemCategoria"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:gravity="center"
        android:text="F1"
        android:textColor="@color/acento"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:fontFamily="sans-serif"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeMaxTextSize="12sp"
        app:autoSizeStepGranularity="0.5sp" />

    <!-- Data e status -->
    <LinearLayout
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/itemData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="30 OUT–01 NOV"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:fontFamily="sans-serif"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeStepGranularity="0.5sp" />

        <TextView
            android:id="@+id/itemStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center"
            android:text="AGENDADA"
            android:textColor="@color/status_azul"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:letterSpacing="0.04"
            android:fontFamily="sans-serif" />
    </LinearLayout>
</LinearLayout>

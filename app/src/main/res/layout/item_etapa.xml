<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:background="@drawable/rounded_card">

    <!-- Faixa lateral na cor da categoria (cor definida no Kotlin) -->
    <View
        android:id="@+id/itemAcento"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:background="#39FF14" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingEnd="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Data: largura fixa para alinhar todos os cards -->
        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/itemDia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="06–08"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:fontFamily="sans-serif-condensed"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="13sp"
                app:autoSizeMaxTextSize="20sp"
                app:autoSizeStepGranularity="0.5sp" />

            <TextView
                android:id="@+id/itemMes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="NOV"
                android:textColor="#39FF14"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:letterSpacing="0.06"
                android:fontFamily="sans-serif-condensed"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeMaxTextSize="11sp"
                app:autoSizeStepGranularity="0.5sp" />
        </LinearLayout>

        <!-- Divisor flutuante -->
        <View
            android:layout_width="1dp"
            android:layout_height="44dp"
            android:background="#1C5413" />

        <ImageView
            android:id="@+id/itemBandeira"
            android:layout_width="32dp"
            android:layout_height="22dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="10dp"
            android:scaleType="centerCrop"
            android:contentDescription="Bandeira do país" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/itemPais"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Brasil"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-condensed"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="18sp"
                app:autoSizeStepGranularity="0.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="3dp"
                    android:src="@drawable/ic_pin"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/itemCircuito"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Interlagos"
                    android:textColor="#9AA6B2"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-condensed" />
            </LinearLayout>
        </LinearLayout>

        <!-- Coluna da direita: categoria (fonte se ajusta ao nome) e status -->
        <LinearLayout
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/itemCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:gravity="center"
                android:text="F1"
                android:textColor="#39FF14"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.06"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeStepGranularity="0.5sp" />

            <TextView
                android:id="@+id/itemStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:gravity="center"
                android:text="PRÓXIMA"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.03"
                android:background="@drawable/status_badge"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="7sp"
                app:autoSizeMaxTextSize="9sp"
                app:autoSizeStepGranularity="0.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
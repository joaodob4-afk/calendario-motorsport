<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071A2D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹  VOLTAR"
            android:textColor="#8FA6BA"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingTop="6dp"
            android:paddingBottom="18dp"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/categoryLogo"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="18dp"
            android:adjustViewBounds="true"
            android:contentDescription="Logo da categoria"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/categoryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FÓRMULA 1"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:paddingBottom="28dp" />

        <TextView
            android:id="@+id/nextEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PRÓXIMO EVENTO"
            android:textColor="#8FA6BA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/nextEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carregando..."
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:padding="22dp"
            android:background="@drawable/rounded_card"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/fullCalendarButton"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="16dp"
            android:text="VER PROGRAMAÇÃO COMPLETA"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:background="@drawable/rounded_card"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/categoryInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B0C0CE"
            android:textSize="15sp"
            android:lineSpacingExtra="5dp"
            android:paddingTop="24dp"
            android:paddingBottom="20dp" />

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<!-- Card do carrossel da tela inicial. Largura e fundo são definidos pelo Kotlin. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="190dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Foto opcional: aparece só se existir um drawable destaque_<categoria> -->
    <ImageView
        android:id="@+id/destaqueImagem"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/destaqueVeu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/veu_destaque"
        android:visibility="gone" />

    <!-- Letreiro gigante e translúcido com o nome da categoria (cor e tamanho vêm do Kotlin) -->
    <TextView
        android:id="@+id/destaqueMarca"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="-6dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textStyle="bold|italic"
        android:fontFamily="sans-serif-black"
        android:importantForAccessibility="no"
        tools:text="F1"
        tools:textSize="110sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Selo da categoria + rótulo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/destaqueBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:maxLines="1"
                android:textColor="#0B0D0F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:fontFamily="sans-serif"
                tools:text="F1" />

            <TextView
                android:id="@+id/destaqueTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/etapa_proxima"
                android:textColor="@color/texto_suave"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12" />
        </LinearLayout>

        <TextView
            android:id="@+id/destaqueNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:maxLines="3"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            tools:text="GP dos Estados Unidos" />

        <!-- Nome do circuito (usado só nas telas de detalhe) -->
        <TextView
            android:id="@+id/destaqueCircuito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/texto_suave"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:visibility="gone"
            tools:text="Circuit of the Americas" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/destaqueBandeira"
                android:layout_width="28dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/cd_bandeira_proxima"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/destaqueLocal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#D5D8DC"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                tools:text="Austin, Estados Unidos" />
        </LinearLayout>

        <!-- Sessão em andamento ou a próxima (dia, hora e nome); some se não houver horário confirmado -->
        <TextView
            android:id="@+id/destaqueSessao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeStepGranularity="1sp"
            tools:text="SEX 13:30 · Treino Livre 1" />

        <!-- Empurra a linha de baixo para o pé do card, mesmo quando o título é curto -->
        <View
            android:id="@+id/destaqueEspaco"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26FFFFFF" />

        <!-- Data à esquerda, contagem regressiva à direita -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/destaqueData"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-medium"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="13sp"
                app:autoSizeMaxTextSize="20sp"
                app:autoSizeStepGranularity="1sp"
                tools:text="23–25 OUT" />

            <TextView
                android:id="@+id/destaqueStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#0B0D0F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:fontFamily="sans-serif"
                tools:text="4 DIAS" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
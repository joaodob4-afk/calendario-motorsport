<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/rounded_card">

    <!-- Coluna da data: largura fixa para alinhar todos os cards -->
    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start|center_vertical">

        <TextView
            android:id="@+id/itemDia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="06–08"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:id="@+id/itemMes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOV"
            android:textColor="#39FF14"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:letterSpacing="0.06"
            android:fontFamily="sans-serif-condensed" />
    </LinearLayout>

    <ImageView
        android:id="@+id/itemBandeira"
        android:layout_width="30dp"
        android:layout_height="20dp"
        android:layout_marginEnd="10dp"
        android:scaleType="fitCenter"
        android:contentDescription="Bandeira do país" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/itemPais"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Brasil"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:id="@+id/itemCircuito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Interlagos"
            android:textColor="#B0C0CE"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed" />
    </LinearLayout>

    <!-- Coluna da direita: categoria em destaque e status; largura fixa para alinhar -->
    <LinearLayout
        android:layout_width="92dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/itemCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center"
            android:text="F1"
            android:textColor="#39FF14"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.06"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeStepGranularity="0.5sp" />

        <TextView
            android:id="@+id/itemStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:gravity="center"
            android:text="PRÓXIMA"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.03"
            android:background="@drawable/status_badge" />
    </LinearLayout>
</LinearLayout>
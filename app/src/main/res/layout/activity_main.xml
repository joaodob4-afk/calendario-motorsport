<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_tela">

    <!-- Conteúdo da tela -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Cabeçalho: botão do menu lateral + categorias -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:padding="10dp"
                android:src="@drawable/ic_menu"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_menu" />

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none"
                android:fillViewport="false">

                <!-- Os botões são criados pelo Kotlin a partir da lista de categorias -->
                <LinearLayout
                    android:id="@+id/containerCategorias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="6dp"
                    android:paddingEnd="10dp" />
            </HorizontalScrollView>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <!-- Próximas etapas: um card por etapa que acontece no mesmo dia, rolando para o lado -->
                <LinearLayout
                    android:id="@+id/painelProximaEtapa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">

                    <com.motorsport.calendario.CarrosselDestaque
                        android:id="@+id/carrosselDestaque"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/containerDestaques"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal" />
                    </com.motorsport.calendario.CarrosselDestaque>

                    <LinearLayout
                        android:id="@+id/indicadoresDestaque"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Busca -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="6dp"
                    android:background="@drawable/campo_busca">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_search"
                        android:tint="@color/texto_suave"
                        android:importantForAccessibility="no" />

                    <EditText
                        android:id="@+id/searchEtapa"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:hint="@string/busca_hint"
                        android:textColor="#FFFFFF"
                        android:textColorHint="@color/texto_suave"
                        android:textSize="15sp"
                        android:singleLine="true"
                        android:inputType="text"
                        android:fontFamily="sans-serif" />

                    <ImageView
                        android:id="@+id/btnFiltro"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_filtro"
                        android:tint="@color/texto_suave"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/cd_filtros" />
                </LinearLayout>

                <!-- A lista controla as margens dos cards -->
                <LinearLayout
                    android:id="@+id/listaEtapas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- Barra inferior: os itens vêm de BarraInferior.itens (Kotlin) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/borda_suave" />

        <LinearLayout
            android:id="@+id/barraInferior"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:background="@color/fundo_tela" />
    </LinearLayout>

    <!-- Painel lateral: o conteúdo vem de MenuPrincipal (Kotlin) -->
    <ScrollView
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/painel_lateral"
        android:clickable="true"
        android:focusable="true"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/containerMenuLateral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp" />
    </ScrollView>
</androidx.drawerlayout.widget.DrawerLayout>
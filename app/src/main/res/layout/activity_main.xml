<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Círculos das categorias -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:fillViewport="false"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <!-- F1 -->
            <LinearLayout
                android:id="@+id/btnF1"
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/category_circle">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="F1"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed" />

                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="0dp"
                    android:text="F1"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center" />

            </LinearLayout>

            <!-- F2 -->
            <LinearLayout
                android:id="@+id/btnF2"
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/category_circle">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="F2"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed" />

                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="0dp"
                    android:text="F2"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center" />

            </LinearLayout>

            <!-- F3 -->
            <LinearLayout
                android:id="@+id/btnF3"
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/category_circle">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="F3"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed" />

                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="0dp"
                    android:text="F3"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center" />

            </LinearLayout>

            <!-- IndyCar -->
            <LinearLayout
                android:id="@+id/btnIndyCar"
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/category_circle">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="INDY"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed" />

                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="0dp"
                    android:text="INDY"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Formula E -->
            <LinearLayout
                android:id="@+id/btnFormulaE"
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/category_circle"
                    android:padding="2dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="FE"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed" />

                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="0dp"
                    android:text="FE"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Conteúdo -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Próxima etapa -->
            <LinearLayout
                android:id="@+id/painelProximaEtapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:orientation="vertical"
                android:padding="22dp"
                android:background="@drawable/next_event_card">

                <TextView
                    android:id="@+id/tituloProximaEtapa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PRÓXIMA ETAPA"
                    android:textColor="#39FF14"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08" />

                <!-- Bandeira e nome da etapa -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/bandeiraProximaEtapa"
                        android:layout_width="44dp"
                        android:layout_height="29dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="Bandeira da próxima etapa"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/nomeProximaEtapa"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="F1 — GP de Singapura"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed" />

                </LinearLayout>

                <TextView
                    android:id="@+id/circuitoProximaEtapa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Marina Bay"
                    android:textColor="#B0C0CE"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-condensed" />

                <TextView
                    android:id="@+id/dataProximaEtapa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="09–11 OUT"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed" />

                <TextView
                    android:id="@+id/contadorProximaEtapa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Faltam poucos dias"
                    android:textColor="#39FF14"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed" />

            </LinearLayout>

            <!-- Espaço -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="18dp" />

            <!-- Barra de pesquisa -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/search_bar">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Pesquisar" />

                <EditText
                    android:id="@+id/searchEtapa"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:hint="Pesquisar etapa..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8FA6BA"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:fontFamily="sans-serif-condensed" />

            </LinearLayout>

            <!-- Lista de etapas -->
            <LinearLayout
                android:id="@+id/listaEtapas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
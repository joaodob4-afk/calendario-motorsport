<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101010">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏁 Motorsport Calendar"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Escolha uma categoria"
            android:textColor="#AAAAAA"
            android:textSize="16sp"
            android:gravity="center"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/btnF1"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:layout_marginBottom="14dp"
            android:background="#D90404"
            android:gravity="center"
            android:text="🏎️  FÓRMULA 1"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnF2"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:layout_marginBottom="14dp"
            android:background="#7B2CBF"
            android:gravity="center"
            android:text="🏎️  FÓRMULA 2"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnF3"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:layout_marginBottom="14dp"
            android:background="#1565C0"
            android:gravity="center"
            android:text="🏎️  FÓRMULA 3"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnIndyCar"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:layout_marginBottom="14dp"
            android:background="#EF6C00"
            android:gravity="center"
            android:text="🏁  INDYCAR"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFormulaE"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:layout_marginBottom="14dp"
            android:background="#2E7D32"
            android:gravity="center"
            android:text="⚡  FÓRMULA E"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/raceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="8dp" />

    </LinearLayout>

</ScrollView>

<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fundo -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background_motorsport"
        android:scaleType="centerCrop"
        android:contentDescription="Fundo de automobilismo" />

    <!-- Escurecimento -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Banner superior -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="#CC102B44">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="110dp"
                    android:src="@drawable/topo_telainicial2"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:contentDescription="Calendário Motorsport" />

            </FrameLayout>

            <!-- Espaço entre banner e cards -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="24dp" />

            <!-- Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- F1 -->
                <LinearLayout
                    android:id="@+id/btnF1"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/rounded_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="58dp"
                        android:src="@drawable/logo_f1"
                        android:scaleType="fitCenter"
                        android:contentDescription="Fórmula 1" />

                </LinearLayout>

                <!-- F2 -->
                <LinearLayout
                    android:id="@+id/btnF2"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/rounded_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="68dp"
                        android:src="@drawable/logo_f2"
                        android:scaleType="fitCenter"
                        android:contentDescription="Fórmula 2" />

                </LinearLayout>

                <!-- F3 -->
                <LinearLayout
                    android:id="@+id/btnF3"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/rounded_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="68dp"
                        android:src="@drawable/logo_f3"
                        android:scaleType="fitCenter"
                        android:contentDescription="Fórmula 3" />

                </LinearLayout>

                <!-- IndyCar -->
                <LinearLayout
                    android:id="@+id/btnIndyCar"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/rounded_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="68dp"
                        android:src="@drawable/logo_indycar"
                        android:scaleType="fitCenter"
                        android:contentDescription="IndyCar" />

                </LinearLayout>

                <!-- Formula E -->
                <LinearLayout
                    android:id="@+id/btnFormulaE"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/rounded_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="75dp"
                        android:src="@drawable/logo_formula_e"
                        android:scaleType="fitCenter"
                        android:contentDescription="Formula E" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_tela">

    <!-- Conteúdo da tela -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Cabeçalho: menu, título e filtros. Cada toque tem 48dp. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/azul_marinho"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:padding="12dp"
                android:src="@drawable/ic_menu"
                android:background="@drawable/bg_botao_icone"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_menu" />

            <!-- Título do app; as categorias agora ficam no painel de filtros (à direita) -->
            <TextView
                android:id="@+id/tituloApp"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- Filtros, com um selo mostrando quantos estão ligados (Kotlin) -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:id="@+id/btnFiltro"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:src="@drawable/ic_coracao"
                    android:background="@drawable/bg_botao_icone"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_favoritas" />

                <TextView
                    android:id="@+id/badgeFiltro"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="1dp"
                    android:background="@drawable/bg_selo_filtro"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#0B0D0F"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- "Finalizadas" + interruptor, acima das etapas (o interruptor é criado pelo Kotlin) -->
        <LinearLayout
            android:id="@+id/barraFinalizadas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/rotuloFinalizadas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/finalizadas_rotulo"
                android:textColor="@color/texto_principal"
                android:textSize="15sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/trocoFinalizadas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/scrollPrincipal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <!-- A lista controla as margens dos cards -->
                <LinearLayout
                    android:id="@+id/listaEtapas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="16dp"
                    android:orientation="vertical" />
            </ScrollView>

            <!-- Mês que acompanha a rolagem; o texto e a posição vêm do Kotlin -->
            <TextView
                android:id="@+id/mesFlutuante"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@color/fundo_tela"
                android:paddingStart="4dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:letterSpacing="0.16"
                android:textColor="@color/texto_suave"
                android:textSize="13sp"
                android:visibility="invisible"
                android:importantForAccessibility="no" />

            <!-- Aparece depois de rolar a lista para baixo (Kotlin) -->
            <ImageView
                android:id="@+id/btnTopo"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="18dp"
                android:padding="14dp"
                android:src="@drawable/ic_seta_topo"
                android:background="@drawable/bg_botao_topo"
                android:elevation="8dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                android:contentDescription="@string/cd_topo" />
        </FrameLayout>

        <!-- Barra inferior: os itens vêm de BarraInferior.itens (Kotlin) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/azul_marinho_borda" />

        <LinearLayout
            android:id="@+id/barraInferior"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:background="@color/azul_marinho" />
    </LinearLayout>

    <!-- Painel lateral: o conteúdo vem de MenuPrincipal (Kotlin) -->
    <ScrollView
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/painel_lateral"
        android:clickable="true"
        android:focusable="true"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/containerMenuLateral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp" />
    </ScrollView>

    <!-- Painel de filtros e favoritas (pela direita): o conteúdo vem de MenuDeFiltros (Kotlin) -->
    <ScrollView
        android:id="@+id/scrollFiltros"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/painel_lateral_direito"
        android:clickable="true"
        android:focusable="true"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/containerFiltros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp" />
    </ScrollView>
</androidx.drawerlayout.widget.DrawerLayout>
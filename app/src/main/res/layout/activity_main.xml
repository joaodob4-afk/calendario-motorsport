<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TÍTULO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏎️"
            android:textColor="#FFFFFF"
            android:textSize="42sp"
            android:gravity="center"
            android:paddingTop="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CALENDÁRIO MOTORSPORT"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TEMPORADA 2026"
            android:textColor="#888888"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="28dp" />

        <!-- LINHA 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnF1"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:text="🏎️&#10;&#10;FÓRMULA 1"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#25252C"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnF2"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:text="🏎️&#10;&#10;FÓRMULA 2"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#25252C"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- LINHA 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnF3"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:text="🏎️&#10;&#10;FÓRMULA 3"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#25252C"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnIndyCar"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:text="🏁&#10;&#10;INDYCAR"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#25252C"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- LINHA 3 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnFormulaE"
                android:layout_width="55%"
                android:layout_height="120dp"
                android:text="⚡&#10;&#10;FÓRMULA E"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#25252C"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="F1 • F2 • F3 • INDYCAR • FÓRMULA E"
            android:textColor="#55555D"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingTop="30dp"
            android:paddingBottom="20dp" />

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101820">

    <!-- CATEGORIAS -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingLeft="8dp"
        android:paddingTop="12dp"
        android:paddingRight="8dp"
        android:paddingBottom="8dp">

        <!-- F1 -->

        <LinearLayout
            android:id="@+id/btnF1"
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:src="@drawable/logo_f1"
                android:background="@drawable/category_circle"
                android:padding="10dp"
                android:scaleType="centerInside" />

        </LinearLayout>

        <!-- F2 -->

        <LinearLayout
            android:id="@+id/btnF2"
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:src="@drawable/logo_f2"
                android:background="@drawable/category_circle"
                android:padding="10dp"
                android:scaleType="centerInside" />

        </LinearLayout>

        <!-- F3 -->

        <LinearLayout
            android:id="@+id/btnF3"
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:src="@drawable/logo_f3"
                android:background="@drawable/category_circle"
                android:padding="10dp"
                android:scaleType="centerInside" />

        </LinearLayout>

        <!-- IndyCar -->

        <LinearLayout
            android:id="@+id/btnIndyCar"
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:src="@drawable/logo_indycar"
                android:background="@drawable/category_circle"
                android:padding="10dp"
                android:scaleType="centerInside" />

        </LinearLayout>

        <!-- Formula E -->

        <LinearLayout
            android:id="@+id/btnFormulaE"
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:src="@drawable/logo_formulae"
                android:background="@drawable/category_circle"
                android:padding="10dp"
                android:scaleType="centerInside" />

        </LinearLayout>

    </LinearLayout>

    <!-- PRÓXIMA ETAPA -->

    <LinearLayout
        android:id="@+id/painelProximaEtapa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="10dp"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/next_event_card">

        <TextView
            android:id="@+id/tituloProximaEtapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PRÓXIMA ETAPA • F1"
            android:textColor="#8FA6BA"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/nomeProximaEtapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="🇸🇬 Singapura"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:id="@+id/circuitoProximaEtapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Marina Bay"
            android:textColor="#B0C0CE"
            android:textSize="14sp"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:id="@+id/dataProximaEtapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="09–11 OUT"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:id="@+id/contadorProximaEtapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="FALTAM 2 DIAS"
            android:textColor="#19B76B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.04" />

    </LinearLayout>

    <!-- CONTEÚDO -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingTop="4dp"
            android:paddingRight="14dp"
            android:paddingBottom="20dp">

            <!-- BUSCA -->

            <EditText
                android:id="@+id/searchEtapa"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/rounded_card"
                android:hint="Pesquisar etapa..."
                android:hintTextColor="#71869A"
                android:textColor="#FFFFFF"
                android:textColorHint="#71869A"
                android:textSize="14sp"
                android:singleLine="true"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:fontFamily="sans-serif-condensed" />

            <!-- LISTA DE ETAPAS -->

            <LinearLayout
                android:id="@+id/listaEtapas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FUNDO -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background_motorsport"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- CAMADA ESCURA SOBRE O FUNDO -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- CONTEÚDO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="24dp">

            <!-- BANNER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="@drawable/rounded_card"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CALENDÁRIO"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="start"
                    android:letterSpacing="0.06"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="5" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MOTORSPORT"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="start"
                    android:letterSpacing="0.06"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="5" />

            </LinearLayout>

            <!-- ÁREA PRINCIPAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- COLUNA DOS CARDS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.88"
                    android:orientation="vertical">

                    <!-- FÓRMULA 1 -->
                    <LinearLayout
                        android:id="@+id/btnF1"
                        android:layout_width="match_parent"
                        android:layout_height="125dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/rounded_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:src="@drawable/logo_f1"
                            android:scaleType="fitCenter"
                            android:contentDescription="Fórmula 1" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="FÓRMULA 1"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingTop="5dp" />

                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="10dp" />

                    <!-- FÓRMULA 2 -->
                    <LinearLayout
                        android:id="@+id/btnF2"
                        android:layout_width="match_parent"
                        android:layout_height="125dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/rounded_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="68dp"
                            android:src="@drawable/logo_f2"
                            android:scaleType="fitCenter"
                            android:contentDescription="Fórmula 2" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="FÓRMULA 2"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingTop="5dp" />

                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="10dp" />

                    <!-- FÓRMULA 3 -->
                    <LinearLayout
                        android:id="@+id/btnF3"
                        android:layout_width="match_parent"
                        android:layout_height="125dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/rounded_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="68dp"
                            android:src="@drawable/logo_f3"
                            android:scaleType="fitCenter"
                            android:contentDescription="Fórmula 3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="FÓRMULA 3"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingTop="5dp" />

                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="10dp" />

                    <!-- INDYCAR -->
                    <LinearLayout
                        android:id="@+id/btnIndyCar"
                        android:layout_width="match_parent"
                        android:layout_height="125dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/rounded_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="68dp"
                            android:src="@drawable/logo_indycar"
                            android:scaleType="fitCenter"
                            android:contentDescription="IndyCar" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="INDYCAR"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingTop="5dp" />

                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="10dp" />

                    <!-- FORMULA E -->
                    <LinearLayout
                        android:id="@+id/btnFormulaE"
                        android:layout_width="match_parent"
                        android:layout_height="125dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/rounded_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="75dp"
                            android:src="@drawable/logo_formulae"
                            android:scaleType="fitCenter"
                            android:contentDescription="Fórmula E" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="FORMULA E"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingTop="5dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ESPAÇO LIVRE À DIREITA -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.12" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
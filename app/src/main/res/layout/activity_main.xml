<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FUNDO -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background_motorsport"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- CAMADA ESCURA -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- CONTEÚDO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ================================================= -->
            <!-- BANNER SUPERIOR -->
            <!-- ================================================= -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:background="#CC102B44">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/topo_telainicial2"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:contentDescription="Calendário Motorsport" />

            </FrameLayout>

            <!-- ESPAÇO ENTRE BANNER E CARDS -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="14dp" />

            <!-- ================================================= -->
            <!-- CARDS -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <!-- FÓRMULA 1 -->

                <LinearLayout
                    android:id="@+id/btnF1"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/rounded_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:src="@drawable/logo_f1"
                        android:scaleType="fitCenter"
                        android:contentDescription="Fórmula 1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="FÓRMULA 1"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingTop="5dp" />

                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="10dp" />

                <!-- FÓRMULA 2 -->

                <LinearLayout
                    android:id="@+id/btnF2"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/rounded_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="68dp"
                        android:src="@drawable/logo_f2"
                        android:scaleType="fitCenter"
                        android:contentDescription="Fórmula 2" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="FÓRMULA 2"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingTop="5dp" />

                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="10dp" />

                <!-- FÓRMULA 3 -->

                <LinearLayout
                    android:id="@+id/btnF3"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/rounded_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="68dp"
                        android:src="@drawable/logo_f3"
                        android:scaleType="fitCenter"
                        android:contentDescription="Fórmula 3" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="FÓRMULA 3"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingTop="5dp" />

                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="10dp" />

                <!-- INDYCAR -->

                <LinearLayout
                    android:id="@+id/btnIndyCar"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/rounded_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="68dp"
                        android:src="@drawable/logo_indycar"
                        android:scaleType="fitCenter"
                        android:contentDescription="IndyCar" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="INDYCAR"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingTop="5dp" />

                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="10dp" />

                <!-- FORMULA E -->

                <LinearLayout
                    android:id="@+id/btnFormulaE"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/rounded_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="75dp"
                        android:src="@drawable/logo_formulae"
                        android:scaleType="fitCenter"
                        android:contentDescription="Fórmula E" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="FORMULA E"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingTop="5dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
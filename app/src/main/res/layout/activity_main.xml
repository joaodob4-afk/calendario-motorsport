<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MOTORSPORT"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingTop="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CALENDÁRIO 2026"
            android:textColor="#77777F"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:paddingTop="6dp"
            android:paddingBottom="30dp" />

        <!-- F1 / F2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnF1"
                android:layout_width="0dp"
                android:layout_height="125dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:text="FÓRMULA 1"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#24242B"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnF2"
                android:layout_width="0dp"
                android:layout_height="125dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:text="FÓRMULA 2"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#24242B"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- F3 / INDYCAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnF3"
                android:layout_width="0dp"
                android:layout_height="125dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:text="FÓRMULA 3"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#24242B"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnIndyCar"
                android:layout_width="0dp"
                android:layout_height="125dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:text="INDYCAR"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#24242B"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- FÓRMULA E -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnFormulaE"
                android:layout_width="220dp"
                android:layout_height="125dp"
                android:text="FÓRMULA E"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#24242B"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="F1  •  F2  •  F3  •  INDYCAR  •  FÓRMULA E"
            android:textColor="#505058"
            android:textSize="11sp"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:paddingTop="30dp"
            android:paddingBottom="20dp" />

    </LinearLayout>

</ScrollView>
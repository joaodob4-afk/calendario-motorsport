<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

        <!-- Cabeçalho: voltar + logo + título -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:text="‹"
                android:textColor="#39FF14"
                android:textSize="34sp"
                android:textStyle="bold"
                android:gravity="center"
                android:contentDescription="Voltar"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/categoryLogo"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="12dp"
                android:adjustViewBounds="true"
                android:maxWidth="96dp"
                android:contentDescription="Logo da categoria"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/categoryTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FÓRMULA 1"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:gravity="start"
                android:letterSpacing="0.06" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="26dp"
            android:background="#39FF14" />

        <TextView
            android:id="@+id/nextEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PRÓXIMO EVENTO"
            android:textColor="#39FF14"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="start"
            android:letterSpacing="0.16"
            android:paddingBottom="10dp" />

        <!-- Cartão principal: o texto é montado pelo código (MainActivity) -->
        <TextView
            android:id="@+id/nextEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="140dp"
            android:text="Carregando..."
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:gravity="start|center_vertical"
            android:lineSpacingExtra="3dp"
            android:paddingStart="22dp"
            android:paddingTop="20dp"
            android:paddingEnd="22dp"
            android:paddingBottom="20dp"
            android:background="@drawable/next_event_card"
            android:clickable="true"
            android:focusable="true" />

        <!-- Botão secundário: só contorno -->
        <TextView
            android:id="@+id/fullCalendarButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="VER PROGRAMAÇÃO COMPLETA   ›"
            android:textColor="#39FF14"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:background="@drawable/category_secondary_button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/categoryInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#AFAFAF"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:paddingTop="24dp"
            android:paddingBottom="20dp" />

    </LinearLayout>

</ScrollView>
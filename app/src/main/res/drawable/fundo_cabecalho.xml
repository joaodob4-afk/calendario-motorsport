<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo azul do cabeçalho com uma linha de destaque na borda de baixo -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/azul_marinho" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/azul_destaque" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Card -->
    <item>
        <shape android:shape="rectangle">

            <gradient
                android:angle="0"
                android:startColor="#162B3D"
                android:endColor="#0C1822" />

            <corners
                android:radius="14dp" />

            <stroke
                android:width="1dp"
                android:color="#31506A" />

        </shape>
    </item>

    <!-- Linha verde lateral arredondada -->
    <item
        android:width="7dp" android:height="match_parent"
        android:gravity="left
        android:left="0dp">

        <shape android:shape="rectangle">

            <solid
                android:color="#19B76B" />

            <corners
                android:radius="4dp" />

        </shape>

    </item>

</layer-list>
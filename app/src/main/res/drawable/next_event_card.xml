<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Card principal -->
    <item>

        <shape android:shape="rectangle">

            <gradient
                android:angle="0"
                android:startColor="#162B3D"
                android:endColor="#0C1822" />

            <corners
                android:radius="14dp" />

            <stroke
                android:width="1dp"
                android:color="#31506A" />

        </shape>

    </item>

    <!-- Detalhe verde integrado à borda esquerda -->
    <item
        android:left="1dp"
        android:top="4dp"
        android:bottom="4dp"
        android:width="4dp">

        <shape android:shape="rectangle">

            <solid
                android:color="#19B76B" />

            <corners
                android:topLeftRadius="2dp"
                android:topRightRadius="2dp"
                android:bottomLeftRadius="2dp"
                android:bottomRightRadius="2dp" />

        </shape>

    </item>

</layer-list>
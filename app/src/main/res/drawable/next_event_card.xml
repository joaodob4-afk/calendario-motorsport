<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base verde -->
    <item>

        <shape android:shape="rectangle">

            <solid
                android:color="#19B76B" />

            <corners
                android:radius="14dp" />

        </shape>

    </item>

    <!-- Corpo do card -->
    <item
        android:left="3dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">

        <shape android:shape="rectangle">

            <gradient
                android:angle="0"
                android:startColor="#162B3D"
                android:endColor="#0C1822" />

            <corners
                android:radius="13dp" />

            <stroke
                android:width="1dp"
                android:color="#31506A" />

        </shape>

    </item>

</layer-list>
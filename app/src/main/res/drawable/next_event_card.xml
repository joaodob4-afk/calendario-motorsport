<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Cor padrão da F1; a cor é substituída pela identidade da categoria em tempo de execução. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E10600" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- Corpo preto do cartão -->
    <item
        android:left="2dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">

        <shape android:shape="rectangle">

            <solid android:color="#000000" />

            <corners android:radius="13dp" />

            <stroke
                android:width="1dp"
                android:color="#39FF14" />

        </shape>

    </item>

</layer-list>